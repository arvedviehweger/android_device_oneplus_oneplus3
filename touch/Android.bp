cc_binary {
    name: "vendor.lineage.touch-service.oneplus3",
    init_rc: ["vendor.lineage.touch-service.oneplus3.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.oneplus3.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        ":vendor.lineage.touch-oneplus-touchgesture",
        "KeyDisabler.cpp",
        "KeySwapper.cpp",
        "service.cpp",
    ],
    local_include_dirs: ["."],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
    header_libs: [
        "vendor.lineage.touch-oneplus-headers",
    ],
}
