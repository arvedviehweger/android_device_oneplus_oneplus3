cc_library_shared {
    name: "libcamera_client_vendor",
    vendor: true,
    srcs: ["CameraMetadata.cpp"],
    include_dirs: [
        "frameworks/av/camera/include",
        "system/media/private/camera/include",
    ],
    shared_libs: [
        "libbinder",
        "libcamera_metadata",
        "libcutils",
        "liblog",
        "libutils",
    ],
    cflags: ["-Wno-unused-parameter"],
}
